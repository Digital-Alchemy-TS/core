{
  "type": "module",
  "name": "@digital-alchemy/core",
  "description": "Application wiring, configuration, and boilerplate utilities",
  "repository": {
    "url": "git+https://github.com/Digital-Alchemy-TS/core"
  },
  "version": "26.10.22",
  "author": {
    "url": "https://github.com/zoe-codez",
    "name": "Zoe Codez"
  },
  "types": "dist/index.d.mts",
  "homepage": "https://docs.digital-alchemy.app",
  "scripts": {
    "build": "rm -rf dist/; tsc -p tsconfig.lib.json",
    "lint": "eslint . --max-warnings 0 && echo \"✓ lint passed\"",
    "test": "vitest",
    "test:cross-package": "bash examples/implies-propagation/run.sh && echo \"✓ test:cross-package passed\"",
    "type-check": "tsc -p tsconfig.typecheck.json && echo \"✓ type-check passed\"",
    "upgrade": "ncu --upgrade --cooldown 48h && truncate -s 0 yarn.lock && yarn install"
  },
  "bugs": {
    "email": "bugs@digital-alchemy.app",
    "url": "https://github.com/Digital-Alchemy-TS/core/issues/new/choose"
  },
  "keywords": [
    "nodejs",
    "boilerplate",
    "automation",
    "typescript",
    "core",
    "digital-alchemy"
  ],
  "funding": [
    {
      "url": "https://github.com/sponsors/zoe-codez",
      "type": "GitHub"
    }
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./testing": "./dist/testing/helpers/index.mjs"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@digital-alchemy/symbols": "26.6.20",
    "@dotenvx/dotenvx": "^2.38.0",
    "chalk": "^6.0.1",
    "cron": "^4.4.0",
    "dayjs": "^1.11.23",
    "ini": "^7.0.0",
    "js-yaml": "^5.5.0",
    "minimist": "^1.2.8",
    "uuid": "^14.0.3"
  },
  "peerDependencies": {
    "typebox": ">=1.3.0 <2.0.0",
    "zod": ">=4.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.4.0",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/ini": "^4.1.1",
    "@types/js-yaml": "^4.0.9",
